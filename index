function cellPresentation(day,slot,c){
  if(!slot){
    const slots=sortSlots(day),before=slots.length&&now.seconds<minutes(slots[0].start)*60,after=slots.length&&now.seconds>=minutes(slots.at(-1).end)*60;
    return{state:before?'BELUM':after?'SELESAI':'—',name:!slots.length?'Tidak ada jadwal':before?'KBM belum dimulai':after?'KBM hari ini selesai':'Jeda antar sesi',subject:'',style:'empty',code:''};
  }
