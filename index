let lastAnimSignature='';
function triggerSlotTransitionEffects(){
  // Animasi panel metrik atas (Sesi sekarang, Sisa waktu, Sesi berikutnya)
  document.querySelectorAll('.hero-strip .metric').forEach((m,idx)=>{
    m.classList.remove('slot-flash');
    void m.offsetWidth;
    setTimeout(()=>m.classList.add('slot-flash'),idx*55);
  });
  // Animasi judul Peta Aktivitas Kelas & angka ringkasan
  const sec=document.querySelector('#liveView .sectionline');
  if(sec){
    sec.classList.remove('map-pulse');
    void sec.offsetWidth;
    sec.classList.add('map-pulse');
  }
  // Gelombang kilatan cahaya perdana setelah kartu selesai berputar
  setTimeout(()=>triggerCardShimmerWave('diagonal'),320);
}

function triggerCardShimmerWave(mode='diagonal'){
  if(ui.view!=='live'||document.hidden)return;
  const cards=[...document.querySelectorAll('#classCards .class-card')];
  if(!cards.length)return;
  cards.forEach((card,idx)=>{
    card.classList.remove('shimmer-sweep');
    const col=idx%11,row=Math.floor(idx/11);
    const delay=mode==='random'
      ? Math.floor(Math.random()*650)
      : (row*95)+(col*48);
    card.style.setProperty('--sweep-delay',delay+'ms');
  });
  // Reflow agar animasi CSS dapat diputar ulang dengan mulus
  void $('classCards').offsetWidth;
  cards.forEach(card=>card.classList.add('shimmer-sweep'));
}

// Efek kilatan cahaya otomatis pada kartu peta aktivitas setiap beberapa detik (6.5 detik)
setInterval(()=>{
  triggerCardShimmerWave('diagonal');
},6500);

function renderMain(day,slot){
  let k=0,r=0,e=0,cardIdx=0;
  const animSig=[ui.day,ui.date,slot?.id||'none',ui.grade,ui.auto?'auto':'manual'].join('|');
  const shouldAnimate=animSig!==lastAnimSignature;
  lastAnimSignature=animSig;
  const bad=new Set(conflicts(day,db).filter(x=>x.a===slot?.id||x.b===slot?.id).flatMap(x=>x.classes));
  $('classCards').innerHTML=['7','8','9'].filter(g=>ui.grade==='all'||g===ui.grade).map(g=>{
    const cs=db.classes.filter(c=>c.grade===g);
    if(!cs.length)return'';
    return`<div class="grade-label">Kelas ${g==='7'?'VII':g==='8'?'VIII':'IX'} <span>${cs.length} ruang</span></div><div class="class-grid">`+cs.map((c,colIdx)=>{
      const p=cellPresentation(day,slot,c);
      if(p.state==='KBM'||p.state==='LITERASI'||p.state==='PENGGANTI')k++;
      else if(p.style==='rest')r++;
      else e++;
      const rowIdx=Math.floor(cardIdx/11);
      const staggerMs=(rowIdx*65)+(colIdx*28);
      const sweepDelayMs=(rowIdx*95)+(colIdx*48);
      cardIdx++;
      return`<button class="class-card ${p.style} ${bad.has(c.name)?'conflict':''} ${shouldAnimate?'slot-transition':''}" style="--stagger:${staggerMs}ms;--sweep-delay:${sweepDelayMs}ms" data-class="${esc(c.id)}" title="Lihat rincian kelas ${esc(c.name)}"><div class="card-top"><span class="class-name">${esc(c.name)}</span><span class="state">${p.state}</span></div><span class="teacher-code">${p.code?'#'+esc(p.code):'—'}</span><div class="teacher-name">${esc(p.name)}</div><div class="subject">${esc(p.subject)}</div></button>`;
    }).join('')+'</div>';
  }).join('');
  $('kbmCount').textContent=k;
  $('restCount').textContent=r;
  $('emptyCount').textContent=e;
  if(shouldAnimate)triggerSlotTransitionEffects();
  if(ui.view==='teacher')renderTeacher();
  if(ui.view==='all')renderAll();
}
