<!doctype html>
<html lang="id" data-theme="dark"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Jadwal Mengajar • SMPN 9 Tangsel</title>
<style>:root{color-scheme:dark;--bg:#07111e;--bg-grad:#102c43;--panel:#0d1c2e;--panel-alt:#101f31;--sidebar-bg:#0b192a;--input-bg:#112339;--btn-hover:#153749;--line:#24384f;--muted:#91a8c1;--text:#eef5ff;--cyan:#49e2d0;--cyan-text:#06252a;--blue:#568bff;--amber:#ffd479;--red:#ff8296;--purple:#a49aff;--card-bg:linear-gradient(150deg,#113c4a 0,#0e2437 72%);--card-border:#236075;--card-class:#a5f8ed;--card-subj:#8ed7eb;--card-shadow:0 4px 12px #0004;--th-bg:#192c42;--th-text:#afc9e3;--sticky-bg:#112238;--scale:1}
html[data-theme="light"]{color-scheme:light;--bg:#f1f5f9;--bg-grad:#dbeafe;--panel:#ffffff;--panel-alt:#f8fafc;--sidebar-bg:#ffffff;--input-bg:#f8fafc;--btn-hover:#e2e8f0;--line:#cbd5e1;--muted:#64748b;--text:#0f172a;--cyan:#0d9488;--cyan-text:#ffffff;--blue:#2563eb;--amber:#d97706;--red:#e11d48;--purple:#7c3aed;--card-bg:linear-gradient(150deg,#f0fdfa 0,#ffffff 85%);--card-border:#99f6e4;--card-class:#0f766e;--card-subj:#0369a1;--card-shadow:0 2px 8px rgba(15,23,42,.06);--th-bg:#f1f5f9;--th-text:#334155;--sticky-bg:#f8fafc}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 85% 0,var(--bg-grad),transparent 45%),var(--bg);color:var(--text);font:calc(14px * var(--scale))/1.45 system-ui,-apple-system,"Segoe UI",sans-serif;transition:background .2s,color .2s}
button,input,select,textarea{font:inherit}
button,select,input,textarea{color:inherit;background:var(--input-bg);border:1px solid var(--line);border-radius:9px}
button{cursor:pointer;padding:9px 13px;transition:background .15s,border-color .15s,transform .1s}
button:hover{border-color:var(--cyan);background:var(--btn-hover)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
button:disabled{cursor:not-allowed;opacity:.4}
.primary{background:var(--cyan);color:var(--cyan-text);border-color:var(--cyan);font-weight:750}
.primary:hover{filter:brightness(1.08);background:var(--cyan)}
.danger{color:var(--red)}
.small{font-size:12px}
.muted{color:var(--muted)}
input,select,textarea{padding:9px;max-width:100%}
input[type=checkbox]{accent-color:var(--cyan)}
.app{padding:18px 22px 0;max-width:2560px;margin:auto}
header{display:flex;align-items:center;gap:13px;padding-bottom:16px;border-bottom:1px solid var(--line)}
.logo{height:48px;width:48px;flex-shrink:0;border:1px solid var(--line);border-radius:14px;display:grid;place-items:center;background:linear-gradient(140deg,#185368,#122438);font-size:24px;font-weight:900;color:#49e2d0;overflow:hidden}
html[data-theme="light"] .logo{background:linear-gradient(140deg,#0d9488,#0f766e);color:#fff}
.logo img{width:100%;height:100%;object-fit:contain}
h1{font-size:clamp(16px,1.45vw,28px);line-height:1.2;margin:0 0 5px;font-weight:800;letter-spacing:.02em}
.brand{flex:1}
.eyebrow{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--cyan);font-weight:750}
.header-tools{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.clockbox{text-align:right;min-width:190px;margin-left:16px}
.clock{font-size:30px;line-height:1.1;font-weight:800;font-variant-numeric:tabular-nums;color:var(--text);letter-spacing:.04em}
.date{font-size:12px;color:var(--muted);margin-top:5px}
.topbar{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:15px 0}
.seg{display:flex;background:var(--panel);padding:3px;border:1px solid var(--line);border-radius:11px;gap:3px}
.seg button{border:0;background:transparent;padding:7px 13px;border-radius:8px}
.seg .on{background:var(--cyan);color:var(--cyan-text);font-weight:700}
.mode{display:flex;align-items:center;gap:7px;font-size:11px;letter-spacing:.07em;text-transform:uppercase;color:var(--cyan);font-weight:750;margin-left:auto}
.dot{width:7px;height:7px;border-radius:100%;background:currentColor;display:inline-block;box-shadow:0 0 10px currentColor}
.layout{display:grid;grid-template-columns:234px minmax(0,1fr);gap:18px}
.sidebar{background:var(--sidebar-bg);border:1px solid var(--line);border-radius:14px;padding:13px;align-self:start;box-shadow:var(--card-shadow)}
.side-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font-weight:750}
.day-chip{background:var(--input-bg);color:var(--cyan);border:1px solid var(--line);padding:3px 8px;border-radius:6px;font-size:11px;font-weight:700}
.session{border:1px solid var(--line);background:var(--panel-alt);border-radius:9px;width:100%;display:flex;justify-content:space-between;text-align:left;padding:10px 9px;margin-bottom:6px;gap:6px;align-items:center}
.session b{display:block;font-size:12px}
.session small{font-size:11px;color:var(--muted);white-space:nowrap;text-align:right}
.session.active{border-color:var(--cyan);background:rgba(73,226,208,.14);box-shadow:inset 3px 0 var(--cyan)}
html[data-theme="light"] .session.active{background:#ccfbf1;border-color:#0d9488}
.session.break{border-left:3px solid var(--amber)}
.session.activity,.session.literasi-slot{border-left:3px solid var(--purple)}
.side-foot{border-top:1px solid var(--line);padding-top:12px;margin-top:10px;display:flex;justify-content:space-between;color:var(--muted);font-size:11px}
.main{min-width:0}
.hero-strip{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:12px}
.metric{background:var(--panel-alt);border:1px solid var(--line);border-radius:12px;padding:11px 14px;min-height:70px;box-shadow:var(--card-shadow)}
.metric small{color:var(--muted);font-size:10px;letter-spacing:.08em;text-transform:uppercase;font-weight:650}
.metric strong{display:block;font-size:20px;margin-top:2px;line-height:1.25}
.metric.count strong{color:var(--amber);font-variant-numeric:tabular-nums}
.progress{height:4px;background:var(--line);border-radius:4px;margin-top:8px;overflow:hidden}
.progress i{display:block;height:100%;background:var(--cyan);width:0}
.sectionline{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:8px 0 12px;flex-wrap:wrap}
.sectionline h2{font-size:15px;margin:0}
.legend{display:flex;gap:14px;font-size:11px;color:var(--muted);flex-wrap:wrap}
.legend span{display:flex;align-items:center;gap:5px}
.legend i{width:7px;height:7px;background:var(--cyan);border-radius:50%}
.legend .gold{background:var(--amber)}
.legend .purple{background:var(--purple)}
.legend .gray{background:#71879b}
.filters{display:flex;gap:6px}
.filters button{padding:5px 10px;font-size:12px}
.filters .on{border-color:var(--cyan);color:var(--cyan);font-weight:700}
.grade-label{font-size:10px;color:var(--muted);letter-spacing:.14em;text-transform:uppercase;margin:11px 0 6px;display:flex;gap:10px;align-items:center;font-weight:700}
.grade-label:after{content:'';height:1px;flex:1;background:var(--line)}
.class-grid{display:grid;grid-template-columns:repeat(11,minmax(0,1fr));gap:8px}
.class-card{min-width:0;min-height:148px;position:relative;border:1px solid var(--card-border);background:var(--card-bg);border-radius:12px;padding:10px;text-align:left;display:flex;flex-direction:column;box-shadow:var(--card-shadow);transition:transform .15s,border-color .15s}
.class-card:hover{transform:translateY(-2px);border-color:var(--cyan)}
.card-top{display:flex;justify-content:space-between;align-items:center;gap:2px}
.class-name{font-size:clamp(16px,1.45vw,27px);line-height:1;font-weight:850;color:var(--card-class)}
.state{font-size:8px;color:var(--cyan);letter-spacing:.02em;border:1px solid var(--card-border);background:rgba(73,226,208,.15);border-radius:4px;padding:2px 5px;white-space:nowrap;font-weight:750}
.teacher-code{display:inline-block;background:rgba(255,212,121,.16);color:var(--amber);font-size:10px;padding:1px 5px;border-radius:4px;align-self:start;margin-top:12px;margin-bottom:4px;font-weight:700}
html[data-theme="light"] .teacher-code{background:#fef3c7;color:#b45309}
.teacher-name{font-size:clamp(11px,.86vw,18px);line-height:1.28;font-weight:700;overflow-wrap:anywhere;color:var(--text)}
.subject{font-size:clamp(10px,.75vw,15px);color:var(--card-subj);margin-top:auto;padding-top:8px;line-height:1.2;font-weight:600}
.class-card.rest{background:linear-gradient(150deg,#3d3625,#162334);border-color:#786541}
html[data-theme="light"] .class-card.rest{background:linear-gradient(150deg,#fef3c7,#fffbeb);border-color:#f59e0b}
.rest .state,.rest .class-name{color:var(--amber)}
.rest .state{border-color:#8c794b;background:rgba(180,142,30,.15)}
.class-card.literasi{border-color:var(--purple);background:linear-gradient(150deg,#2e2559 0,#122238 80%)}
html[data-theme="light"] .class-card.literasi{background:linear-gradient(150deg,#f3e8ff 0,#ffffff 85%);border-color:#c084fc}
.literasi .state,.literasi .class-name{color:var(--purple)}
.literasi .state{border-color:var(--purple);background:rgba(164,154,255,.18)}
.class-card.empty{background:var(--panel-alt);border-color:var(--line)}
.empty .class-name,.empty .state{color:var(--muted)}
.empty .state{border-color:var(--line);background:transparent}
.class-card.special{border-color:#a59bff;background:linear-gradient(150deg,#302f5a,#12253a)}
html[data-theme="light"] .class-card.special{background:linear-gradient(150deg,#ede9fe,#ffffff);border-color:#8b5cf6}
.special .state{color:var(--purple);border-color:var(--purple);background:rgba(112,103,179,.2)}
.class-card.conflict{border-color:var(--red)}
.notice{background:#282437;border:1px solid #584562;color:#ebd9fb;border-radius:10px;padding:10px 13px;font-size:12px;margin-bottom:12px;display:flex;align-items:center;gap:10px}
html[data-theme="light"] .notice{background:#f3e8ff;border-color:#d8b4fe;color:#581c87}
.notice button{margin-left:auto;padding:4px 8px;font-size:11px}
.hidden{display:none!important}
.footer{display:flex;gap:14px;align-items:center;padding:12px 0 10px;margin-top:15px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}
.ticker{flex:1;overflow:hidden;white-space:nowrap}
.ticker span{display:inline-block;animation:marquee 45s linear infinite;padding-left:10%}
@keyframes marquee{to{transform:translateX(-70%)}}
.save-state{white-space:nowrap;color:var(--cyan);font-weight:600}
.view-panel{background:var(--panel);border:1px solid var(--line);padding:18px;border-radius:14px;box-shadow:var(--card-shadow)}
.view-panel h2{margin:0 0 8px;font-size:22px}
.toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.grow{flex:1}
/* Autocomplete Pencarian Guru */
.search-combo{position:relative;flex:1;min-width:260px}
.search-input-wrap{display:flex;align-items:center;background:var(--input-bg);border:1px solid var(--line);border-radius:10px;padding:0 10px;transition:border-color .15s,box-shadow .15s}
.search-input-wrap:focus-within{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(73,226,208,.18)}
.search-icon{color:var(--muted);font-size:14px;margin-right:8px;user-select:none}
.search-input-wrap input{border:0;background:transparent;padding:10px 4px;width:100%;outline:none!important;font-weight:600}
.search-clear{border:0;background:transparent;color:var(--muted);padding:4px 8px;font-size:16px;line-height:1;border-radius:6px}
.search-clear:hover{color:var(--text);background:var(--btn-hover)}
.autocomplete-list{position:absolute;top:calc(100% + 6px);left:0;right:0;background:var(--panel);border:1px solid var(--cyan);border-radius:12px;max-height:320px;overflow-y:auto;z-index:40;box-shadow:0 14px 34px rgba(0,0,0,.35);padding:5px}
html[data-theme="light"] .autocomplete-list{box-shadow:0 12px 28px rgba(15,23,42,.15)}
.ac-item{width:100%;border:0;background:transparent;text-align:left;padding:9px 12px;border-radius:8px;display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:2px}
.ac-item:hover,.ac-item.active{background:var(--btn-hover);border-color:transparent}
.ac-item.selected{background:rgba(73,226,208,.15);border-left:3px solid var(--cyan)}
.ac-main{display:flex;align-items:center;gap:8px;min-width:0}
.ac-code{font-size:11px;font-weight:750;padding:2px 6px;border-radius:5px;background:var(--input-bg);border:1px solid var(--line);color:var(--cyan);flex-shrink:0}
.ac-name{font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ac-name mark{background:rgba(255,212,121,.35);color:inherit;padding:0 2px;border-radius:3px}
.ac-sub{font-size:11px;color:var(--muted);flex-shrink:0;padding:2px 8px;background:var(--panel-alt);border-radius:99px;border:1px solid var(--line)}
.quick-chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;align-items:center}
.quick-chips small{color:var(--muted);font-size:11px;margin-right:4px}
.chip-btn{padding:4px 10px;font-size:11px;border-radius:99px;background:var(--panel-alt);border:1px solid var(--line)}
.chip-btn.on{background:var(--cyan);color:var(--cyan-text);border-color:var(--cyan);font-weight:700}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px;max-height:65vh}
table{border-collapse:separate;border-spacing:0;width:100%;font-size:12px}
th,td{padding:10px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);vertical-align:top;text-align:left}
th{position:sticky;top:0;z-index:2;background:var(--th-bg);color:var(--th-text);white-space:nowrap}
tr:last-child td{border-bottom:0}
td:last-child,th:last-child{border-right:0}
.wide td{min-width:125px}
.wide .sticky{position:sticky;left:0;background:var(--sticky-bg);z-index:1;min-width:150px}
.wide th.sticky{z-index:3;background:var(--th-bg)}
.cell-button{width:100%;background:transparent;border:0;border-radius:4px;padding:0;text-align:left;min-height:48px}
.cell-button b{display:block;color:var(--cyan)}
.tag{font-size:10px;padding:3px 7px;border-radius:6px;background:var(--input-bg);border:1px solid var(--line);display:inline-block;font-weight:600}
.tag.lit{background:rgba(164,154,255,.2);color:var(--purple);border-color:var(--purple)}
.tag.warn{background:#542d3a;color:#ffb5c0}
.empty-note{padding:25px;text-align:center;color:var(--muted)}
dialog{color:var(--text);background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:0;max-height:91vh;width:min(920px,94vw);box-shadow:0 35px 100px #0009}
dialog::backdrop{background:#02091499;backdrop-filter:blur(5px)}
.modal-head{padding:17px 22px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}
.modal-head h2{margin:0;font-size:19px;flex:1}
.modal-body{padding:20px 22px;overflow:auto;max-height:calc(91vh - 130px)}
.modal-foot{display:flex;align-items:center;gap:8px;padding:13px 22px;border-top:1px solid var(--line);justify-content:flex-end}
.modal-foot .muted{margin-right:auto;font-size:12px}
.tabs{display:flex;gap:5px;flex-wrap:wrap;padding:12px 22px 0}
.tabs button{font-size:12px;padding:7px 11px}
.tabs button.on{color:var(--cyan);border-color:var(--cyan);font-weight:700}
label{display:flex;flex-direction:column;gap:6px;color:var(--muted);font-size:12px;margin-bottom:13px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 14px}
.form-grid .full{grid-column:1/-1}
.help{padding:12px;background:var(--panel-alt);border:1px solid var(--line);border-radius:9px;color:var(--muted);font-size:12px;margin:10px 0 15px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.row label{margin:0}
.stack{display:grid;gap:9px}
.slot-edit{display:grid;grid-template-columns:1.5fr 100px 100px 125px 34px;gap:6px;align-items:center}
.slot-edit input,.slot-edit select{min-width:0;width:100%;padding:7px;font-size:12px}
.slot-edit button{padding:6px}
.alert{background:#442b32;color:#ffb6c4;border:1px solid #865260;border-radius:8px;padding:10px;margin:10px 0;font-size:12px}
html[data-theme="light"] .alert{background:#ffe4e6;color:#9f1239;border-color:#fda4af}
.good{background:#173b34;color:#a3efd1;border-color:#28715e}
html[data-theme="light"] .good{background:#d1fae5;color:#065f46;border-color:#6ee7b7}
.toast{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:#d5fff1;color:#073629;border:1px solid #50b994;padding:12px 22px;border-radius:10px;z-index:99;box-shadow:0 10px 30px #0005;font-weight:650;max-width:92vw}
.toast.error{background:#ffe1e5;color:#6c102c;border-color:#dc7890}
.editmode .cell-button:hover{background:var(--btn-hover)}
.conflict-item{border-bottom:1px solid var(--line);padding:12px 0;font-size:13px}
.tv .app{padding:14px 18px 0}
.tv .header-tools .secondary,.tv .topbar .tv-hide{display:none}
.tv .layout{grid-template-columns:210px minmax(0,1fr)}
.tv .class-card{min-height:clamp(145px,20vh,240px)}
.print-title{display:none}
.info-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:15px 0}
.info-grid div{padding:15px;background:var(--panel-alt);border:1px solid var(--line);border-radius:9px}
.info-grid b{font-size:25px;display:block;color:var(--cyan)}
@media(min-width:1800px){.class-card{min-height:190px}.sidebar{font-size:16px}.session b{font-size:15px}.session small{font-size:13px}.layout{grid-template-columns:275px minmax(0,1fr)}.state{font-size:10px}}
@media(max-width:1150px){.class-grid{grid-template-columns:repeat(6,minmax(0,1fr))}.clockbox{min-width:150px}.clock{font-size:25px}.header-tools button{padding:8px}.layout{grid-template-columns:200px minmax(0,1fr)}.brand .eyebrow{font-size:9px}.tv .class-grid{grid-template-columns:repeat(11,minmax(0,1fr));gap:4px}.tv .class-card{padding:6px;min-height:150px}.tv .state{font-size:6px}.tv .teacher-name{font-size:10px}.tv .layout{grid-template-columns:170px 1fr}}
@media(max-width:760px){.app{padding:12px}.logo{width:38px;height:38px}.brand{min-width:0}header{flex-wrap:wrap;gap:9px}.clockbox{margin:0;min-width:auto}.header-tools{order:3;width:100%;justify-content:flex-end}.clock{font-size:20px}.date{font-size:10px}.layout,.tv .layout{grid-template-columns:1fr}.sidebar{display:none}.class-grid,.tv .class-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.class-card{min-height:157px}.teacher-name,.tv .teacher-name{font-size:13px}.class-name{font-size:23px}.hero-strip{grid-template-columns:1fr 1fr}.hero-strip .metric:last-child{grid-column:1/-1;min-height:54px}.metric strong{font-size:18px}.mode{margin-left:0}.legend{display:none}.form-grid{grid-template-columns:1fr}.slot-edit{grid-template-columns:1fr 85px 85px}.slot-edit select{grid-column:1/3}.modal-body{padding:16px}.footer{font-size:10px}.topbar{gap:7px}.seg button{font-size:12px;padding:7px 9px}.info-grid{grid-template-columns:1fr}.tv .class-card{padding:10px}.tv .state{font-size:8px}}
@media print{body{background:white;color:black}.app>header,.topbar,.sidebar,.hero-strip,.sectionline,.footer,.notice,.toolbar button,.header-tools,.quick-chips,dialog{display:none!important}.layout{display:block}.view-panel{border:0;padding:0;box-shadow:none}.table-wrap{max-height:none;overflow:visible;border:1px solid #888}table{font-size:8px}th,td{background:white!important;color:black!important;border-color:#aaa;padding:4px}th{position:static}.wide td{min-width:0}.print-title{display:block;font-size:18px;margin-bottom:14px}.muted{color:#444}.toolbar{display:none}.view-panel h2{font-size:18px}.class-card{background:white;color:black;border:1px solid #999;break-inside:avoid}.class-name,.teacher-name,.subject{color:black}}
@media(min-width:1151px){.tv .app{padding:10px 16px 0}.tv header{padding-bottom:10px}.tv .topbar{padding:9px 0}.tv .hero-strip{margin-bottom:6px}.tv .metric{padding:8px 12px;min-height:65px}.tv .sectionline{margin:6px 0}.tv .grade-label{margin:6px 0 4px}.tv .class-card{height:calc((100dvh - 365px)/3);min-height:130px;padding:8px}.tv .teacher-name{font-size:clamp(10px,.87vw,19px);line-height:1.25}.tv .teacher-code{margin-top:10px}.tv .session{padding:5px 8px;margin-bottom:4px;min-height:34px}.tv .session small{font-size:10px;line-height:1.1}.tv .side-title{margin-bottom:8px}.tv .footer{margin-top:8px;padding:8px 0}.tv .subject{font-size:clamp(9px,.72vw,15px)}}

/* Efek Animasi Pergantian Jam / Sesi & Kilatan Cahaya (Shimmer) */
#classCards{perspective:1200px}
.class-card{overflow:hidden;transform-style:preserve-3d;backface-visibility:hidden;will-change:transform,opacity,box-shadow}

/* Efek Kilatan Cahaya (Light Sweep) pada Kartu Peta Aktivitas */
.class-card::before{
  content:'';
  position:absolute;
  top:-60%;
  left:-130%;
  width:75%;
  height:220%;
  background:linear-gradient(
    90deg,
    transparent 0%,
    rgba(255,255,255,.03) 25%,
    rgba(73,226,208,.28) 50%,
