function renderChecks(){const issues=[];for(const [d,day] of Object.entries(db.week))for(const b of conflicts(day,db))issues.push({...b,location:DAYS[d]});for(const [d,day] of Object.entries(db.exceptions))for(const b of conflicts(day,db))issues.push({...b,location:formatDate(d)});const mismatch=db.teachers.filter(t=>t.referenceJP>0&&teacherLoad(t.id)!==t.referenceJP);$('managerBody').innerHTML=`<h3 style="margin-top:0">Bentrok guru</h3><div class="${issues.length?'alert':'alert good'}">${issues.length?issues.length+' bentrok ditemukan pada jadwal tersimpan.':'Tidak ada bentrok guru.'}</div>${issues.map(b=>`<div class="conflict-item"><b>${esc(b.location)} · ${esc(b.label)} (${b.time})</b><br>${esc(getTeacher(b.teacherId)?.name||b.teacherId)} · kode ${esc(b.teacherId)}<br>Kelas ${esc(b.classes.join(' dan '))}</div>`).join('')}<h3>Perbandingan jumlah JP sumber</h3><p class="muted small">Kolom acuan berasal dari ringkasan pada gambar awal. Selisih berikut membantu pemeriksaan; jumlah JP aplikasi dihitung dari penugasan pada slot KBM.</p><div class="table-wrap"><table><thead><tr><th>Guru</th><th>Acuan gambar</th><th>JP rutin aplikasi</th></tr></thead><tbody>${mismatch.map(t=>`<tr><td>${esc(t.id+' · '+t.name)}</td><td>${t.referenceJP}</td><td>${teacherLoad(t.id)}</td></tr>`).join('')||'<tr><td colspan="3">Tidak ada selisih.</td></tr>'}</tbody></table></div>`;}
function editTeacher(id){const t=getTeacher(id)||{id:'',name:'',subject:''};$('infoTitle').textContent=id?'Ubah data guru':'Tambah guru';$('infoBody').innerHTML=`<form id="teacherForm"><label>Kode guru<input name="id" required maxlength="20" value="${esc(t.id)}"></label><label>Nama lengkap<input name="name" required maxlength="120" value="${esc(t.name)}"></label><label>Mata pelajaran<input name="subject" maxlength="100" value="${esc(t.subject)}" list="subjectList"></label><datalist id="subjectList">${[...new Set(db.teachers.map(x=>x.subject).filter(Boolean))].map(x=>`<option value="${esc(x)}"></option>`).join('')}</datalist><button class="primary" type="submit">Simpan guru</button></form>`;$('teacherForm').onsubmit=e=>{e.preventDefault();const f=new FormData(e.target),newId=f.get('id').trim();if(!newId||db.teachers.some(x=>x.id===newId&&x.id!==id)){toast('Kode guru sudah dipakai atau belum diisi.',true);return}const next=clone(db),obj={...t,id:newId,name:f.get('name').trim(),subject:f.get('subject').trim()};if(id){next.teachers[next.teachers.findIndex(x=>x.id===id)]=obj;eachDay(next,d=>{for(const cells of Object.values(d.assignments))for(const cell of Object.values(cells))if(cell.teacherId===id)cell.teacherId=newId})}else next.teachers.push(obj);if(persist(next)){loadDraft();$('infoDialog').close();renderManager()}};$('infoDialog').showModal()}
