function markDirty(){ed.dirty=true;$('managerHint').textContent='Draf jadwal belum disimpan.'}
async function allowDraftDiscard(){return !ed.dirty||await ask('Abaikan draf jadwal?','Ada perubahan pada jadwal yang belum disimpan. Pilihan ini akan membuang draf tersebut.')}
function validateDay(day){const sorted=sortSlots(day);for(let i=0;i<sorted.length;i++){const s=sorted[i];if(!s.label.trim()||!s.start||!s.end||duration(s)<=0)throw Error('Periksa nama dan rentang waktu pada '+(s.label||'sesi baru')+'.');if(i&&minutes(sorted[i-1].end)>minutes(s.start))throw Error('Waktu '+sorted[i-1].label+' bertumpuk dengan '+s.label+'.')}return true}
async function saveSchedule(){try{validateDay(ed.draft);const bad=conflicts(ed.draft,db);if(bad.length&&!await ask('Simpan dengan '+bad.length+' bentrok?',bad.slice(0,5).map(x=>(getTeacher(x.teacherId)?.name||x.teacherId)+' · '+x.label+' · kelas '+x.classes.join(' dan ')).join('\n')))return;const next=clone(db);ed.draft.slots=sortSlots(ed.draft);if(ed.scope==='date')next.exceptions[ed.date]=clone(ed.draft);else next.week[ed.day]=clone(ed.draft);if(persist(next)){ed.dirty=false;renderEditor()}}catch(e){toast(e.message,true)}}
