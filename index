// Migrasi otomatis Hari Kamis: tambah Jam ke-1 Literasi (07:00-07:40) dan geser KBM ke Jam ke-2 s.d. Jam ke-9 (pulang 14:00)
function ensureThursdayLiteracy(data,forceSyncOnly=false){
  const thu=data?.week?.['4'];
  if(!thu||!Array.isArray(thu.slots))return false;
  let changed=false;
  const hasJp9=thu.slots.some(s=>s.id==='jp9');
  if(!hasJp9&&!forceSyncOnly){
    thu.slots=clone(SEED.week['4'].slots);
    const oldAss=clone(thu.assignments||{});
    const nextAss={};
    for(let i=1;i<=8;i++){
      if(oldAss['jp'+i])nextAss['jp'+(i+1)]=oldAss['jp'+i];
    }
    nextAss.jp1={};
    for(const [cid,cell2] of Object.entries(nextAss.jp2||{})){
      nextAss.jp1[cid]={
        teacherId:cell2.teacherId,
        subject:cell2.subject||'',
        status:cell2.status||'normal',
        note:'Pendamping Literasi'
      };
    }
    thu.assignments=nextAss;
    return true;
  }
  const jp1=thu.slots.find(s=>s.id==='jp1');
  if(jp1&&jp1.label==='Jam ke-1'){jp1.label='Jam ke-1 · Literasi';changed=true;}
  if(thu.assignments?.jp2&&thu.assignments?.jp1){
    for(const [cid,cell2] of Object.entries(thu.assignments.jp2)){
      const cell1=thu.assignments.jp1[cid];
      if(!cell1||cell1.teacherId!==cell2.teacherId||!cell1.note){
        thu.assignments.jp1[cid]={
          teacherId:cell2.teacherId,
          subject:cell1?.subject||cell2.subject||'',
          status:cell2.status||'normal',
          note:cell1?.note||'Pendamping Literasi'
        };
        changed=true;
      }
    }
  }
  return changed;
}

