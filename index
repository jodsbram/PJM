$('importFile').onchange=async e=>{const file=e.target.files[0];e.target.value='';if(!file)return;if(file.size>8*1024*1024){toast('File cadangan maksimal 8 MB.',true);return}try{const next=JSON.parse(await file.text());validate(next);if(await ask('Impor cadangan?','Data sekarang akan diganti dengan '+next.classes.length+' kelas, '+next.teachers.length+' nama, dan '+Object.keys(next.exceptions).length+' perubahan tanggal.'))if(persist(next,'Cadangan berhasil diimpor.')){ed.dirty=false;loadDraft();renderManager()}}catch(e){toast('Impor gagal: '+e.message,true)}};
function exportCsv(){const {day}=selection(),rows=[['Hari','Tanggal','Kelas','Sesi','Mulai','Selesai','Kode guru','Nama guru','Mapel','Status','Catatan']];for(const s of sortSlots(day))for(const c of db.classes.filter(c=>$('allGrade').value==='all'||c.grade===$('allGrade').value)){const a=assignment(day,s.id,c.id),t=getTeacher(a.teacherId);rows.push([DAYS[ui.day],ui.date,c.name,s.label,s.start,s.end,s.type==='lesson'?t?.id||'':'',s.type==='lesson'?t?.name||'':'',s.type==='lesson'?a.subject||t?.subject||'':'',s.type==='lesson'?a.status:s.type,s.type==='lesson'?a.note:''])}const safe=v=>{let s=String(v??'');if(/^[=+@\-\t\r]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"'};download(new Blob(['\ufeff'+rows.map(r=>r.map(safe).join(';')).join('\r\n')],{type:'text/csv;charset=utf-8'}),'Jadwal_'+ui.date+'.csv')}
function showClass(id){const {day,slot}=selection(),c=db.classes.find(c=>c.id===id);$('infoTitle').textContent='Jadwal kelas '+c.name;$('infoBody').innerHTML=`<p class="muted">${DAYS[ui.day]}, ${formatDate(ui.date)}${db.exceptions[ui.date]?' · Jadwal khusus':''}</p><div class="table-wrap"><table><thead><tr><th>Sesi / waktu</th><th>Guru / kegiatan</th><th>Mapel / catatan</th></tr></thead><tbody>${sortSlots(day).map(s=>{const a=assignment(day,s.id,c.id),t=getTeacher(a.teacherId),lit=isLiterasiSlot(s);return`<tr style="${s.id===slot?.id?'background:rgba(73,226,208,.16)':''}"><td><b>${esc(s.label)}</b><br>${s.start}–${s.end}</td><td>${esc(s.type==='lesson'?t?.name||'Belum ada guru':s.label)}${lit?'<br><span class="tag lit">Pendamping Literasi</span>':''}${s.type==='lesson'&&a.status!=='normal'?'<br><span class="tag">'+esc(cellPresentation(day,s,c).state)+'</span>':''}</td><td>${esc(s.type==='lesson'?a.subject||t?.subject||'':'')}<br><span class="muted small">${esc(s.type==='lesson'?a.note:'')}</span></td></tr>`}).join('')}</tbody></table></div>`;$('infoDialog').showModal()}
function showHelp(){$('infoTitle').textContent='Panduan penggunaan';$('infoBody').innerHTML=`<div class="stack"><div><b>1. Pantau otomatis & Tema Tampilan</b><p class="muted">Buka file HTML melalui Chrome atau Edge. Gunakan tombol <b>☀️ Terang / 🌙 Gelap</b> di kanan atas untuk menyesuaikan kenyamanan layar atau TV sekolah.</p></div><div><b>2. Pencarian Cepat Jadwal Guru</b><p class="muted">Pada menu <b>Jadwal guru</b>, ketik sebagian nama guru, kode, atau mata pelajaran di kotak pencarian untuk langsung menampilkan daftar pilihan instan beserta filter cepat per mata pelajaran.</p></div><div><b>3. Hari Kamis Jam Pertama (Literasi)</b><p class="muted">Hari Kamis Jam ke-1 (07.00–07.40 WIB) telah disetel sebagai <b>Jam ke-1 · Literasi</b>, dengan guru pendamping di kelas yang otomatis disamakan dengan guru mengajar pada Jam ke-2.</p></div><div><b>4. Edit data & Sinkronisasi</b><p class="muted">Buka Kelola → Jadwal & waktu. Pada hari Kamis tersedia tombol <b>Samakan Guru Jam ke-1 = Jam ke-2</b> untuk menyelaraskan otomatis jika ada pembaruan jadwal.</p></div><div><b>5. Cadangkan hasil edit</b><p class="muted">Data tersimpan di browser yang sama. Gunakan Kelola → Cadangan untuk mengunduh JSON atau HTML berisi data terbaru.</p></div></div>`;$('infoDialog').showModal()}
let askResolver;function ask(title,body){let el=$('confirmDialog');if(!el){el=document.createElement('dialog');el.id='confirmDialog';el.style.width='min(480px,94vw)';el.innerHTML='<div class="modal-head"><h2 id="confirmTitle"></h2></div><div class="modal-body" id="confirmBody" style="white-space:pre-line"></div><div class="modal-foot"><button id="confirmNo">Batal</button><button id="confirmYes" class="primary">Lanjutkan</button></div>';document.body.appendChild(el);$('confirmNo').onclick=()=>{el.close();askResolver?.(false)};$('confirmYes').onclick=()=>{el.close();askResolver?.(true)};el.oncancel=e=>{e.preventDefault();el.close();askResolver?.(false)}}$('confirmTitle').textContent=title;$('confirmBody').textContent=body;el.showModal();return new Promise(resolve=>askResolver=resolve)}
async function closeManager(){if(!await allowDraftDiscard())return;ed.dirty=false;$('manager').close()}
document.addEventListener('click',async e=>{const b=e.target.closest('button');if(!b)return;if(b.dataset.close){if(b.dataset.close==='manager')await closeManager();else $(b.dataset.close).close()}if(b.dataset.view){ui.view=b.dataset.view;render(true)}if(b.dataset.grade){ui.grade=b.dataset.grade;document.querySelectorAll('#gradeFilters button').forEach(x=>x.classList.toggle('on',x===b));render(true)}if(b.dataset.slot){ui.auto=false;ui.slot=b.dataset.slot;lastAnimSignature='';render(true)}if(b.dataset.class)showClass(b.dataset.class);if(b.dataset.tab){if(b.dataset.tab!==managerTab&&!await allowDraftDiscard())return;ed.dirty=false;loadDraft();managerTab=b.dataset.tab;renderManager()}if(b.dataset.editSlot)editCell(b.dataset.editSlot,b.dataset.editClass);if(b.dataset.deleteSlot){const s=ed.draft.slots.find(x=>x.id===b.dataset.deleteSlot);if(await ask('Hapus sesi '+s.label+'?','Sesi dan penugasannya pada draf ini akan dihapus.')){ed.draft.slots=ed.draft.slots.filter(x=>x.id!==s.id);delete ed.draft.assignments[s.id];markDirty();renderEditor()}}if(b.dataset.changeTeacher)editTeacher(b.dataset.changeTeacher);if(b.dataset.deleteTeacher)deleteTeacher(b.dataset.deleteTeacher);if(b.dataset.changeClass)editClass(b.dataset.changeClass);if(b.dataset.deleteClass)deleteClass(b.dataset.deleteClass);if(b.dataset.editException){managerTab='schedule';ed.scope='date';ed.date=b.dataset.editException;ed.day=dayFromDate(ed.date);loadDraft();renderManager()}if(b.dataset.deleteException&&await ask('Kembali ke jadwal rutin?','Perubahan khusus '+formatDate(b.dataset.deleteException)+' akan dihapus.')){const next=clone(db);delete next.exceptions[b.dataset.deleteException];if(persist(next))renderManager()}});
$('managerBody').addEventListener('input',e=>{const row=e.target.closest('[data-time-id]');if(row){const s=ed.draft.slots.find(x=>x.id===row.dataset.timeId);s[e.target.dataset.field]=e.target.value;markDirty()}});
$('manager').addEventListener('cancel',e=>{e.preventDefault();closeManager()});
$('daySelect').onchange=e=>{ui.auto=false;ui.day=Number(e.target.value);const delta=(ui.day-now.day+7)%7,d=new Date(now.date+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+delta);ui.date=d.toISOString().slice(0,10);$('dateSelect').value=ui.date;const day=effectiveDay(db,ui.date,ui.day);ui.slot=sortSlots(day).find(s=>s.type==='lesson')?.id||sortSlots(day)[0]?.id||null;render(true)};
$('dateSelect').onchange=e=>{if(!e.target.value)return;ui.auto=false;ui.date=e.target.value;ui.day=dayFromDate(ui.date);$('daySelect').value=ui.day;const day=effectiveDay(db,ui.date,ui.day);ui.slot=sortSlots(day).find(s=>s.type==='lesson')?.id||sortSlots(day)[0]?.id||null;render(true)};
$('autoBtn').onclick=()=>{ui.auto=true;lastAnimSignature='';tick();render(true)};$('teacherSelect').onchange=e=>{selectTeacherById(e.target.value)};$('teacherPeriod').onclick=()=>{ui.teacherWeek=!ui.teacherWeek;render(true)};$('allGrade').onchange=renderAll;$('exportCsv').onclick=exportCsv;$('manageBtn').onclick=()=>openManager();$('helpBtn').onclick=showHelp;$('sourceCheck').onclick=()=>openManager('checks');$('dismissNotice').onclick=()=>$('sourceNotice').classList.add('hidden');$('tvBtn').onclick=()=>{ui.tv=!ui.tv;document.body.classList.toggle('tv',ui.tv);$('tvBtn').textContent=ui.tv?'Keluar TV':'Mode TV';if(ui.tv)$('sourceNotice').classList.add('hidden')};$('fullBtn').onclick=async()=>{try{if(document.fullscreenElement)await document.exitFullscreen();else await document.documentElement.requestFullscreen()}catch(e){toast('Gunakan F11 untuk layar penuh pada komputer ini.')}};
const mobileSelect=document.createElement('select');mobileSelect.id='mobileSession';mobileSelect.setAttribute('aria-label','Pilih sesi');mobileSelect.style.display='none';document.querySelector('.topbar').insertBefore(mobileSelect,$('autoBtn'));const mobileStyle=document.createElement('style');mobileStyle.id='mobileStyle';mobileStyle.textContent='@media(max-width:760px){#mobileSession{display:block!important;max-width:100%}}';document.head.appendChild(mobileStyle);const baseRenderSessions=renderSessions;renderSessions=function(day,slot){baseRenderSessions(day,slot);mobileSelect.innerHTML='<option value="">Pilih sesi…</option>'+sortSlots(day).map(s=>`<option value="${esc(s.id)}" ${slot?.id===s.id?'selected':''}>${esc(s.label)} · ${s.start}–${s.end}</option>`).join('')};mobileSelect.onchange=e=>{if(!e.target.value)return;ui.auto=false;ui.slot=e.target.value;lastAnimSignature='';render(true)};
