$('teacherQuickSearch').addEventListener('focus',e=>{
  e.target.select();
  renderTeacherSuggestions(e.target.value,true);
});
$('teacherQuickSearch').addEventListener('input',e=>{
  acIndex=0;
  renderTeacherSuggestions(e.target.value,false);
});
$('teacherQuickSearch').addEventListener('keydown',e=>{
  const box=$('teacherSuggestions');
  const items=[...box.querySelectorAll('[data-pick-teacher]')];
  if(e.key==='ArrowDown'){
    e.preventDefault();
    if(box.classList.contains('hidden')){renderTeacherSuggestions(e.target.value,false);return;}
    if(items.length){acIndex=(acIndex+1)%items.length;renderTeacherSuggestions(e.target.value,false);items[acIndex]?.scrollIntoView({block:'nearest'});}
  }else if(e.key==='ArrowUp'){
    e.preventDefault();
    if(items.length){acIndex=(acIndex-1+items.length)%items.length;renderTeacherSuggestions(e.target.value,false);items[acIndex]?.scrollIntoView({block:'nearest'});}
  }else if(e.key==='Enter'){
    e.preventDefault();
    const target=items[acIndex>=0?acIndex:0];
    if(target)selectTeacherById(target.dataset.pickTeacher);
  }else if(e.key==='Escape'){
    box.classList.add('hidden');
  }
});
$('teacherSearchClear').onclick=()=>{
  $('teacherQuickSearch').value='';
  $('teacherQuickSearch').focus();
  acIndex=0;
  renderTeacherSuggestions('',true);
};
document.addEventListener('click',e=>{
  const pick=e.target.closest('[data-pick-teacher]');
  if(pick){selectTeacherById(pick.dataset.pickTeacher);return;}
  const chip=e.target.closest('[data-subj-chip]');
  if(chip){
    ui.subjectFilter=chip.dataset.subjChip;
    renderSubjectChips();
    const matches=getFilteredTeachers('');
    if(matches.length&&!matches.some(t=>t.id===ui.teacherId)){
      selectTeacherById(matches[0].id);
    }
    renderTeacherSuggestions($('teacherQuickSearch').value,true);
    return;
  }
  if(!e.target.closest('#teacherCombo')){
    $('teacherSuggestions')?.classList.add('hidden');
  }
});

