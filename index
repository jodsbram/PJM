// Fitur Pencarian Cepat Guru (Autocomplete Live Search)
let acIndex=-1;
function highlightMatch(text,query){
  if(!query)return esc(text);
  const idx=text.toLowerCase().indexOf(query.toLowerCase());
  if(idx===-1)return esc(text);
  return esc(text.slice(0,idx))+'<mark>'+esc(text.slice(idx,idx+query.length))+'</mark>'+esc(text.slice(idx+query.length));
}
function getFilteredTeachers(query){
  const q=query.trim().toLowerCase();
  return db.teachers.filter(t=>{
    if(ui.subjectFilter&&t.subject!==ui.subjectFilter)return false;
    if(!q)return true;
    return (t.name+' '+t.id+' '+t.subject).toLowerCase().includes(q);
  });
}
function renderTeacherSuggestions(query,showAll=false){
  const box=$('teacherSuggestions');
  const q=showAll?'':query;
  const matches=getFilteredTeachers(q);
  if(!matches.length){
    box.innerHTML='<div class="muted small" style="padding:10px 12px">Nama guru tidak ditemukan. Coba kata kunci lain.</div>';
    box.classList.remove('hidden');
    acIndex=-1;
    return;
  }
  box.innerHTML=matches.map((t,idx)=>`<button type="button" class="ac-item ${t.id===ui.teacherId?'selected':''} ${idx===acIndex?'active':''}" data-pick-teacher="${esc(t.id)}"><div class="ac-main"><span class="ac-code">#${esc(t.id)}</span><span class="ac-name">${highlightMatch(t.name,q.trim())}</span></div><span class="ac-sub">${esc(t.subject||'Tanpa mapel')}</span></button>`).join('');
  box.classList.remove('hidden');
}
function selectTeacherById(id){
  const t=getTeacher(id);
