  15%{opacity:1}
  85%{opacity:1}
  100%{left:165%;opacity:0}
}

/* Efek Papan Split-Flap / 3D Cascade saat ganti sesi / cek urutan waktu manual */
.class-card.slot-transition{
  animation:
    cardFlipCascade .62s cubic-bezier(.2,.85,.25,1.05) var(--stagger, 0ms) both,
    cardBorderPulse .9s ease-out var(--stagger, 0ms);
}
@keyframes cardFlipCascade{
  0%{
    opacity:0;
    transform:perspective(900px) rotateX(-68deg) translateY(16px) scale(.92);
    filter:brightness(1.5) blur(2px);
  }
  55%{
    opacity:1;
    transform:perspective(900px) rotateX(8deg) translateY(-2px) scale(1.015);
    filter:brightness(1.18) blur(0);
  }
  100%{
    opacity:1;
    transform:perspective(900px) rotateX(0deg) translateY(0) scale(1);
    filter:brightness(1) blur(0);
  }
}
@keyframes cardBorderPulse{
